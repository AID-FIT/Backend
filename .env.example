# AID-FIT backend environment example.
# Copy to `.env` for local development.
# Copy selected values to `.env.k3s` or GitHub Actions secrets for K3s deployment.

APP_NAME=AID-FIT Backend
ENVIRONMENT=local
API_V1_PREFIX=/api/v1

# Local Docker Compose PostgreSQL.
# In K3s, use:
# DATABASE_URL=postgresql+asyncpg://aidfit:CHANGE_ME@postgres-svc:5432/aidfit
DATABASE_URL=postgresql+asyncpg://aidfit:aidfit@localhost:5432/aidfit
POSTGRES_USER=aidfit
POSTGRES_PASSWORD=aidfit
POSTGRES_DB=aidfit

# Supabase + Vercel (serverless).
# Use the Transaction pooler URI (port 6543) and set DB_USE_PGBOUNCER=true so
# SQLAlchemy disables prepared statements and per-instance connection pooling.
# DATABASE_URL=postgresql+asyncpg://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
DB_USE_PGBOUNCER=false

# Auth.
# Generate a production value with:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me-to-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Image upload.
# Local default serves files from http://localhost:8000/uploads.
# K3s HTTPS example: https://api.aidfit.o-r.kr
LOCAL_UPLOAD_DIR=uploads
PUBLIC_BASE_URL=http://localhost:8000

# Supabase Storage.
# Serverless hosts have no persistent disk, so uploads must go to object storage.
# Set both values to switch away from the local-disk fallback above.
# SUPABASE_SERVICE_KEY is the service_role / secret key — never expose it to clients.
# The bucket must exist and be public for the returned image URLs to resolve.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_STORAGE_BUCKET=uploads
SUPABASE_TIMEOUT_SECONDS=30

# Frontend origins.
# Expo web often uses localhost:19006 or 8081.
# Physical mobile devices need your Mac/server LAN IP origin where applicable.
CORS_ORIGINS=http://localhost:8081,http://localhost:19006,http://localhost:3000

# AI module mode.
# true uses deterministic local mocks; false uses Gemini and ChromaDB.
USE_MOCK_AI=true

# Gemini LLM.
# Set USE_MOCK_AI=false to use Gemini for intent routing, query refinement,
# retrieval planning, general chat, and final recommendation generation.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-flash-preview
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_TIMEOUT_SECONDS=60

# Gemini Vision (VLM).
# VLM_MODEL is optional and falls back to GEMINI_MODEL when empty.
# VLM_MAX_IMAGE_BYTES rejects uploads that are too large to inline into a request.
VLM_MODEL=
VLM_TIMEOUT_SECONDS=30
VLM_MAX_CONCURRENCY=4
VLM_MAX_IMAGE_BYTES=8388608
# One outfit photo can yield several items; this caps how many are kept.
VLM_MAX_ITEMS_PER_IMAGE=8

# Conversational RAG candidate cache.
RAG_CANDIDATE_CACHE_TTL_SECONDS=900

# ChromaDB product retrieval. Use /app/data/... paths in K3s.
RAG_VECTOR_DB_PATH=data/chromadb_final
RAG_COLLECTION_NAME=musinsa
RAG_EMBEDDING_MODEL=jhgan/ko-sroberta-multitask
RAG_EMBEDDING_CACHE_PATH=data/huggingface
# Set true only after the embedding model is present in the cache above.
RAG_EMBEDDING_LOCAL_FILES_ONLY=false

# Social login.
# GOOGLE_CLIENT_IDS accepts comma-separated OAuth client IDs:
# GOOGLE_CLIENT_IDS=web-client-id.apps.googleusercontent.com,ios-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_IDS=

# APPLE_CLIENT_IDS accepts comma-separated Bundle IDs or Services IDs:
# APPLE_CLIENT_IDS=com.aidfit.app
APPLE_CLIENT_IDS=

# Development only. Never enable this on a shared or production server.
AUTH_ALLOW_UNVERIFIED_TOKENS=false
